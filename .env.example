# Host bindings for the unauthenticated console and RTSP publisher.
CONSOLE_BIND=127.0.0.1
CONSOLE_PORT=8080
RTSP_BIND=127.0.0.1
RTSP_PORT=8554

PLAYER_BIND=0.0.0.0
PLAYER_PORT=8081
# Host/IP reachable from the browser, without scheme or port. Comma-separated allowed.
ICE_HOSTS=127.0.0.1
ICE_UDP_PORT=8189

STREAM_PATH=live
# Optional browser-facing WHEP endpoint. Empty uses /gateway/<STREAM_PATH>/whep.
WHEP_URL=
MAX_UPLOAD_BYTES=536870912
